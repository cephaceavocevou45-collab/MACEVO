# Generate a stable value with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Set True only for local development.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL for the main MACEVO backend.
# Leave empty for local SQLite development. Required when ENVIRONMENT=production.
ENVIRONMENT=development
DATABASE_URL=
DB_CONN_MAX_AGE=60

MACEVO_IA_BASE_URL=http://127.0.0.1:8100
# Shared by the main backend and MACEVO_IA.
MACEVO_IA_SERVICE_TOKEN=
MACEVO_IA_TIMEOUT=120

# Shared AI provider configuration for both services.
AI_PROVIDER=ollama
AI_MODEL=
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=1024
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
